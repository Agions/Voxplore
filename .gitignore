Thumbs.db
desktop.ini

# ── 环境变量 ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── 应用运行时 ───────────────────────────────────────────────────────
*.log
temp/
cache/
output/
exports/
outputs/

# ── AI 模型文件（防止大文件误入库）───────────────────────────────────
*.pt
*.pth
*.onnx
*.h5

# ── 媒体文件（不入库）─────────────────────────────────────────────────
*.mp4
*.avi
*.mov
